  "official_basis": {
    "_comment": "Used when a rule is triggered by an official warning (e.g. a DMH flood or cyclone warning) instead of model data, so the notice does not call itself model-based. {alerts} = the official warnings' titles. Needs Burmese review like all wording.",
    "important_note": {
      "my": "ဒီကျန်းမာရေးအသိပေးချက်က အထက်မှာပြထားတဲ့ DMH ရဲ့ တရားဝင်သတိပေးချက်ကို အခြေခံထားတာပါ။ ဒီအသိပေးချက်ကိုယ်တိုင်က တရားဝင်သတိပေးချက် မဟုတ်ပါ။ ရွှေ့ပြောင်းဖို့နဲ့ ဒေသအလိုက် ညွှန်ကြားချက်တွေအတွက် DMH နဲ့ ဒေသအာဏာပိုင်တွေရဲ့ ညွှန်ကြားချက်ကို လိုက်နာပါ။",
      "en": "This health notice follows the official DMH warning shown above. The notice itself is not an official warning; for evacuation and local instructions, follow DMH and local authorities."
    },
    "situation": {
      "my": "ဒီဒေသအတွက် DMH က တရားဝင်သတိပေးချက် ထုတ်ပြန်ထားပါတယ် – {alerts}။",
      "en": "An official DMH warning is in force for this area: {alerts}."
    },
    "situation_rules": [
      "R08",
      "R12"
    ]
  },
  "alert_class_policy": {
    "_comment": "Presentation policy (risk_engine/classes.py), not a scientific threshold. Classes: information < watch < advisory. official_warning is reserved for alerts issued by DMH and is never produced by a rule.",
    "cap_by_knowledge_class": {
      "A": "advisory",
      "B": "watch",
      "C": "information",
      "D": "information"
    },
    "advisory_requires": "severity >= high and the signal starts within 24 hours"
  }
}
