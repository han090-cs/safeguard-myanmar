# Copy to .env for local development. NEVER commit .env.
# RIMES is preferred when an authorised server-side endpoint is available. Do not scrape the login-only DataEx UI.
RIMES_ENABLED=true
RIMES_API_URL=
RIMES_API_TOKEN=
RIMES_API_TIMEOUT=10
# Open-Meteo needs no key. The providers below are fallbacks.
# Identifies this app to the free hazard feeds (USGS, GDACS). Put your contact email in it.
APP_USER_AGENT=MyanmarWeather/9 (you@example.com)
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# true when a proxy (Caddy, nginx, Render) sits in front. A proxy on 127.0.0.1 is detected automatically.
TRUST_PROXY_HEADERS=false
# Your public address, used for the share link, canonical URL and sitemap. Example: https://weather.example.com
PUBLIC_BASE_URL=
# Per-visitor API calls per window (default 120 per 60 s; mobile carriers share IPs, so keep it generous).
# RATE_LIMIT_MAX=120
WEATHER_HTTP_TIMEOUT=12
WEATHER_PROVIDER_TIMEOUT=8
WEATHER_CACHE_TTL=900
WEATHER_STALE_TTL=21600
CITIES_DB_PATH=
# Optional: CORS regex. If unset, localhost and private LAN IPs (any port) are allowed; set ALLOWED_ORIGINS for public sites.
# ALLOWED_ORIGIN_REGEX=
